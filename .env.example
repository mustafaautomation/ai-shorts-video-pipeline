# Copy to .env and fill only the keys you have. The pipeline runs with none of them set.
# Never commit .env. This portfolio demo does not call live social publish APIs.

# Script writer. auto tries Groq, then Gemini, then the offline writer.
SCRIPT_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Voiceover. auto tries Edge TTS, then the offline tone bed with word timings.
VOICE_PROVIDER=auto
EDGE_TTS_VOICE=en-US-AriaNeural

# Portrait b-roll. When empty, the renderer draws gradient plates and kinetic type.
PEXELS_API_KEY=

# Where renders and mock publish receipts are written.
OUTPUT_DIR=out

# Adapters always dry-run unless you later wire an approved live client.
# Tokens below are read only so a future live client can be dropped in.
# They are redacted in receipts and are not sent anywhere by this demo.
PUBLISH_DRY_RUN=true
# Graph API version used in every Instagram URL (Python, web demo, n8n). Empty means v21.0.
GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional base URL used by the n8n and Make blueprints.
SHORTS_API_BASE=http://127.0.0.1:8080

# Daily pipeline. Every one of these is optional. Empty means the free default.
APIFY_TOKEN=
FAL_KEY=
FAL_VIDEO_MODEL=kling
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COST_CAP_USD=1

# n8n canvas only. Set these as n8n variables; the Run config node reads them.
# Comma-separated Instagram usernames for the Apify scrape. Empty scrapes nothing.
SOURCE_INSTAGRAM_USERNAMES=
# Regenerations (Rewrite script or Redo clips) allowed in one run.
MAX_REGENERATIONS=2
# Times one reel may be started before later runs stop picking it.
MAX_REEL_ATTEMPTS=3
# Polls of the Flux still (10 s apart) before the run stops.
MAX_STILL_POLLS=30
# Polls of the image-to-video clip (30 s apart) before the run stops.
MAX_CLIP_POLLS=40
# Polls of the Creatomate render (15 s apart) before the run stops.
MAX_RENDER_POLLS=40
# Polls of the Instagram container (10 s apart) before the run stops.
MAX_CONTAINER_POLLS=30
# Estimated USD for one Flux still, used by the cost cap check.
COST_PER_STILL_USD=0.03
# Estimated USD for one image-to-video clip, used by the cost cap check.
COST_PER_CLIP_USD=0.10
# Estimated USD for one voiceover, used by the cost cap check.
COST_VOICE_USD=0.03
# Estimated USD for one Creatomate render, used by the cost cap check.
COST_RENDER_USD=0.08

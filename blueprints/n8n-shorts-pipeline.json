{
  "name": "Daily Instagram Reels Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "n01",
      "name": "09:00 daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~instagram-reel-scraper/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{$credentials.httpQueryAuth.value}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: ['fieldnotes'], resultsLimit: 10 }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "n02",
      "name": "Apify \u2014 scrape Reels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        280
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "apifyApiToken",
          "name": "Apify API token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst ranked = rows.map(r => ({...r, engagement: ((r.likesCount||r.likes||0)+(r.commentsCount||r.comments||0))/Math.max(r.videoViewCount||r.views||1,1)})).sort((a,b)=>b.engagement-a.engagement);\nreturn ranked.map(json => ({json}));"
      },
      "id": "n03",
      "name": "Rank by views / engagement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.used = staticData.used || [];\nconst fresh = items.find(i => !staticData.used.includes(String(i.json.id||i.json.shortCode)));\nif (!fresh) return [{json:{newReel:false}}];\nconst id = String(fresh.json.id||fresh.json.shortCode);\nstaticData.used.push(id);\nreturn [{json:{...fresh.json, newReel:true, reelId:id}}];"
      },
      "id": "n04",
      "name": "Dedupe check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.newReel}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "n05",
      "name": "New Reel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        280
      ]
    },
    {
      "parameters": {},
      "id": "n06",
      "name": "Already used \u2014 end",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1600,
        460
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.videoUrl || $json.video_url}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 60000
        }
      },
      "id": "n07",
      "name": "Download source MP4",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        560
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "whisper-large-v3"
            },
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "n08",
      "name": "Transcribe (Whisper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        560
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "groqApiKey",
          "name": "Groq API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', response_format: {type:'json_object'}, messages: [{role:'system', content:'Write an original short. Never copy the transcript. Return JSON {hook, script, voiceover, scenes:[{prompt, narration}]}.'}, {role:'user', content: $json.text || ''} ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n09",
      "name": "Script + scene prompts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,

      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll"
      },
      "id": "n17",
      "name": "Clips + voice",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        520,
        1160
      ]
    },
    {
      "parameters": {
        "method": "POST",

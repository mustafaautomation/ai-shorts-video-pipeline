      "typeVersion": 4.2,
      "position": [
        760,
        860
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "falApiKey",
          "name": "fal.ai API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "n13",
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1040,
        860
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://queue.fal.run/requests/{{$json.request_id}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "n14",
      "name": "Poll fal status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        860
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "falApiKey",
          "name": "fal.ai API key"
        }
      },

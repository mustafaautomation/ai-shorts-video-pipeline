        "url": "https://queue.fal.run/fal-ai/flux/dev",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $json.prompt, image_size: 'portrait_16_9' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n11",
      "name": "fal.ai Flux",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        860
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "falApiKey",

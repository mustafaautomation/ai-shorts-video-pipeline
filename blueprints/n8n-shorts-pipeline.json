      "credentials": {
        "httpHeaderAuth": {
          "id": "groqApiKey",
          "name": "Groq API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "fieldToSplitOut": "scenes"
      },
      "id": "n10",
      "name": "Scenes",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        240,
        860
      ]

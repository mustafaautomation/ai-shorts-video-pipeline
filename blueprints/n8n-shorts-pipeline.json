        "jsCode": "const data = $getWorkflowStaticData('global');\ndata.posts = data.posts || [];\ndata.posts.push({ reelId: $json.reelId, permalink: $json.permalink || 'mock://post', at: new Date().toISOString() });\nreturn [{json:{logged:true, posts:data.posts.length}}];"

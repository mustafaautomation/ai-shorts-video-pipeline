    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.creatomate.com/v1/renders/{{$json.id}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "n19",
      "name": "Render ready?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        1160
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "creatomateApiKey",
          "name": "Creatomate API key"
        }
      },

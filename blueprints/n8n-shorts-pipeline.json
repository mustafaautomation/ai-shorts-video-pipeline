    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{$json.hook || 'Reel ready'}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": [
                {
                  "text": "Approve",
                  "additionalFields": {
                    "callback_data": "approve"
                  }
                },
                {
                  "text": "Regenerate",
                  "additionalFields": {
                    "callback_data": "regenerate"
                  }
                }
              ]
            }
          ]
        },
        "additionalFields": {}
      },
      "id": "n20",
      "name": "Send video + buttons",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        1160
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegramBot",
          "name": "Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Approve",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.callback_data || $json.data}}",
                    "rightValue": "approve",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "Regenerate",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.callback_data || $json.data}}",
                    "rightValue": "regenerate",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
